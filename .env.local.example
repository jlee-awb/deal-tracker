# Copy this file to .env.local (not committed) and fill in your real Neon
# connection string. Get it from your Neon project dashboard → Connection
# string. Add the same value to Vercel: Project Settings → Environment
# Variables → DATABASE_URL.

DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/neondb?sslmode=require"

# Optional, local sync-engine testing only: path to a throwaway .xlsx file
# on your own machine. Never point this at a real copy of Weekly
# Update.xlsx — it exists so /sync's "Run sync now" / "Push approved
# changes" buttons have something to talk to before GraphExcelAdapter
# exists. Leave unset in production.
# SYNC_LOCAL_XLSX_PATH="/absolute/path/to/a/throwaway-copy.xlsx"

# Interim single-user auth (see README) — required in every environment,
# including production, until this is replaced with real Entra ID sign-in.
# APP_PASSWORD: pick anything; it's the one shared password that gates the
# whole app. AUTH_SECRET: generate with `npx auth secret` or
# `openssl rand -base64 32` — this signs session tokens, keep it private.
APP_PASSWORD="change-me"
AUTH_SECRET="generate-a-real-random-value-and-never-commit-it"
